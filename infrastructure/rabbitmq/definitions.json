{
  "rabbit_version": "3.13.0",
  "rabbitmq_version": "3.13.0",
  "product_name": "RabbitMQ",
  "product_version": "3.13.0",

  "vhosts": [
    { "name": "/" }
  ],

  "users": [
    {
      "name": "rabbitmq",
      "password_hash": "",
      "hashing_algorithm": "rabbit_password_hashing_sha256",
      "tags": ["administrator"],
      "limits": {}
    }
  ],

  "permissions": [
    {
      "user": "rabbitmq",
      "vhost": "/",
      "configure": ".*",
      "write": ".*",
      "read": ".*"
    }
  ],

  "exchanges": [
    {
      "name": "commands",
      "vhost": "/",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "events",
      "vhost": "/",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "telemetry",
      "vhost": "/",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "tasks",
      "vhost": "/",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "dlx",
      "vhost": "/",
      "type": "direct",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    }
  ],

  "queues": [
    {
      "name": "commands.orchestrator",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum",
        "x-dead-letter-exchange": "dlx",
        "x-dead-letter-routing-key": "commands.dead"
      }
    },
    {
      "name": "events.orchestrator",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum",
        "x-dead-letter-exchange": "dlx",
        "x-dead-letter-routing-key": "events.dead"
      }
    },
    {
      "name": "events.gateway",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "classic",
        "x-max-length": 10000,
        "x-overflow": "drop-head"
      }
    },
    {
      "name": "telemetry.orchestrator",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "classic",
        "x-message-ttl": 60000,
        "x-max-length": 100000,
        "x-overflow": "drop-head"
      }
    },
    {
      "name": "tasks.orchestrator",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum",
        "x-dead-letter-exchange": "dlx",
        "x-dead-letter-routing-key": "tasks.dead"
      }
    },
    {
      "name": "tasks.communication",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "classic",
        "x-message-ttl": 30000,
        "x-max-length": 10000,
        "x-overflow": "drop-head"
      }
    },
    {
      "name": "commands.dead",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "classic",
        "x-message-ttl": 86400000,
        "x-max-length": 10000
      }
    },
    {
      "name": "events.dead",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "classic",
        "x-message-ttl": 86400000,
        "x-max-length": 10000
      }
    },
    {
      "name": "tasks.dead",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "classic",
        "x-message-ttl": 86400000,
        "x-max-length": 10000
      }
    }
  ],

  "bindings": [
    {
      "source": "commands",
      "vhost": "/",
      "destination": "commands.orchestrator",
      "destination_type": "queue",
      "routing_key": "commands.#",
      "arguments": {}
    },
    {
      "source": "events",
      "vhost": "/",
      "destination": "events.orchestrator",
      "destination_type": "queue",
      "routing_key": "events.#",
      "arguments": {}
    },
    {
      "source": "events",
      "vhost": "/",
      "destination": "events.gateway",
      "destination_type": "queue",
      "routing_key": "events.#",
      "arguments": {}
    },
    {
      "source": "telemetry",
      "vhost": "/",
      "destination": "telemetry.orchestrator",
      "destination_type": "queue",
      "routing_key": "telemetry.#",
      "arguments": {}
    },
    {
      "source": "tasks",
      "vhost": "/",
      "destination": "tasks.orchestrator",
      "destination_type": "queue",
      "routing_key": "tasks.orchestrator.#",
      "arguments": {}
    },
    {
      "source": "tasks",
      "vhost": "/",
      "destination": "tasks.communication",
      "destination_type": "queue",
      "routing_key": "tasks.communication.#",
      "arguments": {}
    },
    {
      "source": "dlx",
      "vhost": "/",
      "destination": "commands.dead",
      "destination_type": "queue",
      "routing_key": "commands.dead",
      "arguments": {}
    },
    {
      "source": "dlx",
      "vhost": "/",
      "destination": "events.dead",
      "destination_type": "queue",
      "routing_key": "events.dead",
      "arguments": {}
    },
    {
      "source": "dlx",
      "vhost": "/",
      "destination": "tasks.dead",
      "destination_type": "queue",
      "routing_key": "tasks.dead",
      "arguments": {}
    }
  ],

  "policies": [
    {
      "vhost": "/",
      "name": "ha-all",
      "pattern": "^(commands|events|tasks)\\.",
      "apply-to": "queues",
      "definition": {
        "ha-mode": "all",
        "ha-sync-mode": "automatic"
      },
      "priority": 0
    },
    {
      "vhost": "/",
      "name": "telemetry-ttl",
      "pattern": "^telemetry\\.",
      "apply-to": "queues",
      "definition": {
        "message-ttl": 60000,
        "max-length": 100000,
        "overflow": "drop-head"
      },
      "priority": 1
    }
  ],

  "parameters": [],
  "global_parameters": [
    {
      "name": "cluster_name",
      "value": "agentsswarm"
    }
  ]
}
