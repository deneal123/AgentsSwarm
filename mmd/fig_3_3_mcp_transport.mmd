graph TB
    EnvVar["MCP_TRANSPORT\nпеременная окружения"]

    SSEMode["SSE режим\nFastAPI + uvicorn"]
    StdioMode["stdio режим\nsubprocess"]

    SSEEndpoint["HTTP endpoint /sse\nServer-Sent Events"]
    StdioPipe["stdin / stdout\nстандартные потоки"]

    SSEConn["HTTP Keep-Alive\nevent stream"]
    StdioConn["IPC без сетевого стека\nлокальное тестирование"]

    MCPClient["Orchestrator\nMCP Client"]

    ProdNote["Docker Compose\nПорты :8010 · :8011 · :8012"]
    LocalNote["Локальный запуск\nбез Docker"]

    EnvVar -->|"= sse"| SSEMode
    EnvVar -->|"= stdio"| StdioMode

    SSEMode --> SSEEndpoint
    SSEEndpoint --> SSEConn
    SSEConn --> MCPClient

    StdioMode --> StdioPipe
    StdioPipe --> StdioConn
    StdioConn --> MCPClient

    SSEConn -.-> ProdNote
    StdioConn -.-> LocalNote

