graph TB
    Request["Входящий запрос\nHTTP POST /task"]
    Planner["Planner\nLLM + эвристический fallback"]
    Runner["PlanRunner\nпоследовательное исполнение шагов"]
    Router["Router Agent\nкатегории маршрутизации · handoff"]

    RobotInfo["RobotInfo\nстатус и диагностика"]
    MapAnalyst["MapAnalyst\nvision-LLM"]
    Navigation["Navigation\nнавигация"]
    Charging["Charging\nзарядка"]
    Patrol["Patrol\nпатрулирование"]
    Inspection["Inspection\nинспекция"]
    FleetOps["FleetOps\nмониторинг флота"]
    SwarmCoordinator["SwarmCoordinator\nкоординация роя"]
    General["General\nобщие вопросы"]

    MCPLayer["MCP Layer\nmission-control · mission-dispatch · ros-msp"]

    Request --> Planner
    Planner --> Runner
    Runner --> Router
    Runner -->|"movement tasks"| MapAnalyst
    Router -->|"robot_info"| RobotInfo
    Router -->|"navigation"| Navigation
    Router -->|"charging"| Charging
    Router -->|"patrol"| Patrol
    Router -->|"inspection"| Inspection
    Router -->|"fleet_ops"| FleetOps
    Router -->|"swarm_coord"| SwarmCoordinator
    Router -->|"general"| General

    RobotInfo & MapAnalyst & Navigation & Charging --> MCPLayer
    Patrol & Inspection & FleetOps & SwarmCoordinator --> MCPLayer

