graph LR
    POST["POST /api/chats/{thread_id}/message\nсоздание Celery-задачи"]
    Pending["pending\nожидание воркера"]
    Running["running\nCelery выполняет"]
    Completed["completed\nagent_reply получен"]
    Error["error\nисключение / таймаут"]

    StreamChunk["stream_chunk\nфрагмент ответа"]
    AgentReply["agent_reply\nфинальный ответ"]
    RoutingEvent["routing_event\nhandoff агента"]
    ToolEvent["tool_event\nвызов инструмента"]

    RedisStream["Redis Stream\nchat:{thread_id}:stream\nXADD"]
    WebSocket["WebSocket\n/api/chats/{thread_id}/ws\nXREAD → push → клиент"]

    POST -->|"apply_async"| Pending
    Pending -->|"Celery pick up"| Running
    Running -->|"agent_reply"| Completed
    Running -->|"exception"| Error

    Running --> StreamChunk & AgentReply & RoutingEvent & ToolEvent
    StreamChunk & AgentReply & RoutingEvent & ToolEvent -->|"XADD"| RedisStream
    RedisStream -->|"XREAD block=1000 ms"| WebSocket

    style POST fill:none,stroke:#ff6b6b,stroke-width:2px,color:#000
    style Pending fill:none,stroke:#ffa500,stroke-width:2px,color:#000
    style Running fill:none,stroke:#ffa500,stroke-width:2px,color:#000
    style Completed fill:none,stroke:#52c41a,stroke-width:2px,color:#000
    style Error fill:none,stroke:#ff6b6b,stroke-width:2px,color:#000
    style StreamChunk fill:none,stroke:#4a9eff,stroke-width:2px,color:#000
    style AgentReply fill:none,stroke:#4a9eff,stroke-width:2px,color:#000
    style RoutingEvent fill:none,stroke:#4a9eff,stroke-width:2px,color:#000
    style ToolEvent fill:none,stroke:#4a9eff,stroke-width:2px,color:#000
    style RedisStream fill:none,stroke:#9b59b6,stroke-width:2px,color:#000
    style WebSocket fill:none,stroke:#ffa500,stroke-width:2px,color:#000
