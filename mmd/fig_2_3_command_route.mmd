graph TB
    User["Пользователь"] -->|"команда"| Interface["Interface\nReact + FastAPI"]
    Interface -->|"POST /task"| Orchestrator["Orchestrator\nOpenAI Agents SDK"]
    Orchestrator -->|"карта, маршрут, objective"| MCP1["mission-control-mcp\n:8010 / SSE"]
    MCP1 -->|"Mission Control REST"| MissionControl["Mission Control\nBehavior Tree + cuOpt"]

    Orchestrator -->|"dispatch миссии"| MCP2["mission-dispatch-mcp\n:8011 / SSE"]
    MCP2 -->|"Mission Dispatch REST"| MissionDispatch["Mission Dispatch\nVDA5050 Fleet Manager"]
    MissionControl --> MissionAPI["Mission API\nREST"]
    MissionDispatch --> MissionAPI
    MissionAPI -->|"VDA5050 order"| MQTT["Mosquitto MQTT\nVDA5050"]
    MQTT -->|"order"| Robot["Isaac ROS / Carter\nсимулятор"]

    Robot -.->|"state"| MQTT
    MQTT -.->|"status / events"| MissionAPI
    MissionAPI -.->|"результат"| MCP2
    MCP2 -.->|"результат инструмента"| Orchestrator
    Orchestrator -.->|"stream событий"| Interface
    Interface -.->|"статус выполнения"| User

    style User fill:none,stroke:#ff6b6b,stroke-width:2px,color:#000
    style Interface fill:none,stroke:#ff6b6b,stroke-width:2px,color:#000
    style Orchestrator fill:none,stroke:#ffa500,stroke-width:2px,color:#000
    style MCP1 fill:none,stroke:#4a9eff,stroke-width:2px,color:#000
    style MCP2 fill:none,stroke:#4a9eff,stroke-width:2px,color:#000
    style MissionControl fill:none,stroke:#4a9eff,stroke-width:2px,color:#000
    style MissionDispatch fill:none,stroke:#4a9eff,stroke-width:2px,color:#000
    style MissionAPI fill:none,stroke:#4a9eff,stroke-width:2px,color:#000
    style MQTT fill:none,stroke:#9b59b6,stroke-width:2px,color:#000
    style Robot fill:none,stroke:#52c41a,stroke-width:2px,color:#000
