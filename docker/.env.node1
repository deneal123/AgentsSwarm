# ===========================================
# Node 1 Configuration (Worker)
# ===========================================
# Copy this file to .env on Node 1 server
#
# Usage:
#   cp .env.node1 .env
#   docker-compose up -d
#
# IMPORTANT: Change DATA_PARALLEL_ADDRESS to Node 0's IP!

# -------------------------------------------
# Model Configuration
# -------------------------------------------
MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
MODEL_DTYPE=auto
MAX_MODEL_LEN=4096
GPU_MEMORY_UTILIZATION=0.9

# -------------------------------------------
# Server Configuration
# -------------------------------------------
PORT=8000
API_KEY=your-api-key-here
HOSTNAME=vllm-node-1
CONTAINER_NAME=vllm-node1

# -------------------------------------------
# Network Configuration (required for Data Parallel)
# -------------------------------------------
# Use host network for ZMQ communication
VLLM_NETWORK_MODE=host
VLLM_IPC_MODE=host
# CUDA device for this container
CUDA_VISIBLE_DEVICES=1

# -------------------------------------------
# Data Parallel Configuration
# -------------------------------------------
# Total number of nodes in the cluster
DATA_PARALLEL_SIZE=2

# This node's rank (1 = worker)
DATA_PARALLEL_RANK=1

# IP address of the coordinator node (Node 0)
# CHANGE THIS to Node 0's actual IP address
DATA_PARALLEL_ADDRESS=192.168.1.100

# RPC port for coordination (must match Node 0)
DATA_PARALLEL_RPC_PORT=13345

# Number of GPUs on this node
DATA_PARALLEL_SIZE_LOCAL=1

# -------------------------------------------
# Engine Configuration
# -------------------------------------------
TENSOR_PARALLEL_SIZE=1
MAX_NUM_SEQS=256
MAX_NUM_BATCHED_TOKENS=8192

# -------------------------------------------
# Logging
# -------------------------------------------
LOG_LEVEL=INFO
