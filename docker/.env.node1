# ===========================================
# Node 1 Configuration (Worker)
# ===========================================
# Copy this file to .env on Node 1 server
#
# Usage:
#   cp .env.node1 .env
#   docker-compose up -d

# -------------------------------------------
# Model Configuration
# -------------------------------------------
VLLM_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
VLLM_MODEL_DTYPE=auto
VLLM_MAX_MODEL_LEN=4096
VLLM_GPU_MEMORY_UTILIZATION=0.9

# -------------------------------------------
# Server Configuration
# -------------------------------------------
VLLM_PORT=8000
VLLM_API_KEY=your-api-key-here
VLLM_HOSTNAME=vllm-node-1

# -------------------------------------------
# Data Parallel Configuration
# -------------------------------------------
# Total number of nodes in the cluster
VLLM_DATA_PARALLEL_SIZE=2

# This node's rank (1 = worker)
VLLM_DATA_PARALLEL_RANK=1

# IP address of the coordinator node (Node 0)
# CHANGE THIS to Node 0's actual IP address
VLLM_DATA_PARALLEL_ADDRESS=10.0.0.1

# RPC port for coordination (must match Node 0)
VLLM_DATA_PARALLEL_RPC_PORT=13345

# Number of GPUs on this node
VLLM_DATA_PARALLEL_SIZE_LOCAL=1

# -------------------------------------------
# Engine Configuration
# -------------------------------------------
VLLM_TENSOR_PARALLEL_SIZE=1
VLLM_MAX_NUM_SEQS=256
VLLM_MAX_NUM_BATCHED_TOKENS=8192

# -------------------------------------------
# Logging
# -------------------------------------------
VLLM_LOG_LEVEL=INFO
