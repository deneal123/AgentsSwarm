    "paths": {
      "@shared/ui/*": [
        "shared/ui/*"
      ],
      "@shared/ui": [
        "shared/ui"
      ],
      "@features/*": [
        "features/*"
      ],
      "@pages/*": [
        "pages/*"
      ],
      "@utils/*": [
        "utils/*"
