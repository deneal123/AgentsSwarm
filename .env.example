# Environment variables for SmolVLA Optimization Project

# Optional settings
RUN_MODE=poetry # legacy

# Dataset Configuration
# Path where downloaded datasets will be cached
HF_DATASETS_CACHE=./datasets_cache

# Percentage of dataset to download and use (0.01 = 1%, 1.0 = 100%)
DATASET_DOWNLOAD_PERCENTAGE=0.1

# Model Configuration
# HuggingFace model ID for SmolVLA
SMOLVLA_MODEL_ID=lerobot/smolvla_base

# Training Configuration
# Default number of training epochs
DEFAULT_EPOCHS=20

# Default batch size
DEFAULT_BATCH_SIZE=32

# Default learning rate
DEFAULT_LEARNING_RATE=1e-4

# Hardware Configuration
# Enable mixed precision training (true/false)
ENABLE_MIXED_PRECISION=true

# Enable CUDA if available (true/false)
ENABLE_CUDA=true

# Logging Configuration
# Logging level (DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=INFO

# Output directory for results
OUTPUT_DIR=./results

# Profiling Configuration
# Enable performance profiling (true/false)
ENABLE_PROFILING=false

# Enable quantization analysis (true/false)
ENABLE_QUANTIZATION_ANALYSIS=false

# Enable pruning analysis (true/false)
ENABLE_PRUNING_ANALYSIS=false

# Cache Configuration
# Transformers cache directory
TRANSFORMERS_CACHE=./transformers_cache

# HuggingFace token (optional, for private models)
HF_TOKEN=

# Development Configuration
# Enable debug mode (true/false)
DEBUG=false

# Number of workers for data loading
NUM_WORKERS=2

# Suppress video-related warnings (true/false)
SUPPRESS_VIDEO_WARNINGS=true