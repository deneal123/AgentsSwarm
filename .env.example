# =============================================================================
# AgentsSwarm — шаблон переменных окружения
# Скопируйте в .env и заполните реальными значениями
# =============================================================================

# ─── Общие ───────────────────────────────────────────────────────────────────
APP_ENV=development                       # development | production
LOG_LEVEL=INFO                            # DEBUG | INFO | WARNING | ERROR

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agentsswarm
POSTGRES_USER=agentsswarm
POSTGRES_PASSWORD=changeme
POSTGRES_URL=postgresql+asyncpg://agentsswarm:changeme@localhost:5432/agentsswarm

# ─── InfluxDB ────────────────────────────────────────────────────────────────
INFLUXDB_HOST=localhost
INFLUXDB_PORT=8086
INFLUXDB_ORG=agentsswarm
INFLUXDB_BUCKET_TELEMETRY=telemetry
INFLUXDB_BUCKET_METRICS=metrics
INFLUXDB_BUCKET_EVENTS=events
INFLUXDB_ADMIN_TOKEN=changeme-influx-admin-token
INFLUXDB_ORCHESTRATOR_TOKEN=changeme-influx-orchestrator-token
INFLUXDB_GATEWAY_TOKEN=changeme-influx-gateway-token
INFLUXDB_URL=http://localhost:8086

# ─── Neo4j ───────────────────────────────────────────────────────────────────
NEO4J_HOST=localhost
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=changeme
REDIS_URL=redis://:changeme@localhost:6379/0
REDIS_INSIGHT_PORT=8001

# ─── MinIO ───────────────────────────────────────────────────────────────────
MINIO_HOST=localhost
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme
MINIO_URL=http://localhost:9000

# ─── EMQX (MQTT) ─────────────────────────────────────────────────────────────
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_PORT_TLS=8883
MQTT_PORT_WS=8083
MQTT_DASHBOARD_PORT=18083
MQTT_USERNAME=agentsswarm
MQTT_PASSWORD=changeme
MQTT_SUPERUSER_PASSWORD=changeme-super

# ─── RabbitMQ ────────────────────────────────────────────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=agentsswarm
RABBITMQ_PASSWORD=changeme
RABBITMQ_VHOST=/
RABBITMQ_URL=amqp://agentsswarm:changeme@localhost:5672/

# ─── JWT (GatewayService) ────────────────────────────────────────────────────
JWT_SECRET=changeme-super-secret-jwt-key-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── GatewayService ──────────────────────────────────────────────────────────
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8005
GATEWAY_WORKERS=4
RATE_LIMIT_REST=100          # req/min per user
RATE_LIMIT_CHAT=30           # msg/min per user

# ─── Orchestrator ────────────────────────────────────────────────────────────
ORCHESTRATOR_HOST=0.0.0.0
ORCHESTRATOR_GRPC_PORT=50050
ORCHESTRATOR_HEALTH_PORT=8006
ORCHESTRATOR_WORKERS=2
CELERY_CONCURRENCY=4

# ─── vLLM Service ────────────────────────────────────────────────────────────
VLLM_HOST=localhost
VLLM_PORT=8003
VLLM_URL=http://localhost:8003
MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
MULTIMODAL_MODEL_NAME=HuggingFaceTB/SmolVLM2-2.2B-Instruct
GPU_MEMORY_UTILIZATION=0.9
MAX_MODEL_LEN=8192
TENSOR_PARALLEL_SIZE=1
QUANTIZATION=                # awq | gptq | (пусто = нет)
LORA_MODULES_PATH=/lora_adapters

# ─── Triton Inference ────────────────────────────────────────────────────────
TRITON_HOST=localhost
TRITON_HTTP_PORT=8000
TRITON_GRPC_PORT=8001
TRITON_METRICS_PORT=8002
TRITON_URL=http://localhost:8000
MODEL_REPOSITORY_PATH=/model_repository
MODEL_CONTROL_MODE=poll
BATCH_SIZE=8
MAX_QUEUE_DELAY_MS=5

# ─── SmolVLA Service ─────────────────────────────────────────────────────────
SMOLVLA_HOST=localhost
SMOLVLA_GRPC_PORT=50051
SMOLVLA_URL=localhost:50051
SMOLVLA_MODEL_ID=lerobot/smolvla_base
XVLA_MODEL_ID=lerobot/xvla-base
SMOLVLA_DEVICE=cuda:0
SMOLVLA_DTYPE=bfloat16
ACTIONS_PER_CHUNK=50

# ─── OpenTelemetry / Jaeger ──────────────────────────────────────────────────
JAEGER_HOST=localhost
JAEGER_PORT=6831
JAEGER_ENDPOINT=http://localhost:4317   # OTLP gRPC endpoint
OTEL_SERVICE_NAME=agentsswarm

# ─── GPU ─────────────────────────────────────────────────────────────────────
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility

# ─── Robot Edge (per-robot override) ─────────────────────────────────────────
ROBOT_ID=robot_001
ROBOT_MODEL=mobile_manipulator
EDGE_MODE=hybrid              # online | offline | hybrid
