ENV=dev
HOST=0.0.0.0
PORT=8000
RELOAD=0

# Redis backend for sessions
REDIS_URL=redis://redis:6379/0

# ─── MCP transport ─────────────────────────────────────────────────────────────
# Transport mode for each MCP server:
#   stdio  → orchestrator spawns MCP server as a subprocess (local dev, no Docker)
#   sse    → orchestrator connects to a running MCP container via HTTP/SSE

MISSION_CONTROL_TRANSPORT=sse
# URL of the mission-control-mcp SSE endpoint (inside Docker network)
MISSION_CONTROL_MCP_URL=http://mission-control-mcp:8000/sse

MISSION_DISPATCH_TRANSPORT=sse
# URL of the mission-dispatch-mcp SSE endpoint (inside Docker network)
MISSION_DISPATCH_MCP_URL=http://mission-dispatch-mcp:8000/sse

# ─── Upstream external services ────────────────────────────────────────────────
# These are passed to the MCP containers (not used directly by the orchestrator)
MISSION_CONTROL_URL=http://195.225.110.91:8050
MISSION_DISPATCH_URL=http://185.55.57.82:8051

# ─── stdio fallback (used when MISSION_*_TRANSPORT=stdio) ──────────────────────
MISSION_CONTROL_COMMAND=python
MISSION_CONTROL_ARGS=-m mission_control_mcp.server
MISSION_DISPATCH_COMMAND=python
MISSION_DISPATCH_ARGS=-m mission_dispatch_mcp.server

# ─── ROS-MSP (rosbridge MCP) ───────────────────────────────────────────────────
ROS_MSP_TRANSPORT=sse
ROS_MSP_MCP_URL=http://ros-msp:8000/sse

# rosbridge endpoint — IP of the machine running rosbridge_server (workspace / Isaac host)
ROSBRIDGE_IP=195.225.110.91
ROSBRIDGE_PORT=9090

# stdio fallback (used when ROS_MSP_TRANSPORT=stdio)
ROS_MSP_COMMAND=uv
ROS_MSP_ARGS=--directory /opt/ros-mcp-server run server.py

# ─── Agents SDK / LLM providers ────────────────────────────────────────────────
# Enable SDK-backed execution instead of simulator
AGENTS_USE_SDK=0

# Provider switch: openai (default) | vllm
AGENTS_PROVIDER=openai

# OpenAI (if AGENTS_PROVIDER=openai)
OPENAI_API_KEY=changeme
OPENAI_BASE_URL=https://api.openai.com/v1

# vLLM (if AGENTS_PROVIDER=vllm)
VLLM_BASE_URL=http://vllm-service:8000/v1
VLLM_API_KEY=optional-token

# Optional proxy
PROXY_HOST=
PROXY_PORT=
PROXY_USER=
PROXY_PASS=

# Model and generation settings
AGENTS_MODEL=gpt-4o-mini
AGENTS_TEMPERATURE=0.3
AGENTS_TOP_P=
AGENTS_MAX_OUTPUT_TOKENS=
AGENTS_NEST_HANDOFF_HISTORY=0
AGENTS_TRACING_DISABLED=1

# Planner replan attempts on failure (0 = no replan, 1 = single retry)
PLAN_REPLAN_MAX=1
