ENV=dev
HOST=0.0.0.0
PORT=8000
RELOAD=0

# Redis backend for sessions
REDIS_URL=redis://redis:6379/0

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins, or * to allow all (default for dev).
# Example for production: http://frontend.example.com,https://frontend.example.com
CORS_ORIGINS=*

# ─── MCP transport ─────────────────────────────────────────────────────────────
# Transport mode for each MCP server:
#   sse    → orchestrator connects to a running MCP container via HTTP/SSE (Docker)
#   stdio  → orchestrator spawns MCP server as a subprocess (local dev, no Docker)
#   streamable-http → HTTP streaming transport (newer MCP spec)

MISSION_CONTROL_TRANSPORT=sse
# URL of the mission-control-mcp SSE endpoint (inside Docker network)
MISSION_CONTROL_MCP_URL=http://mission-control-mcp:8000/sse

MISSION_DISPATCH_TRANSPORT=sse
# URL of the mission-dispatch-mcp SSE endpoint (inside Docker network)
MISSION_DISPATCH_MCP_URL=http://mission-dispatch-mcp:8000/sse

# ─── Upstream external services ────────────────────────────────────────────────
# Direct HTTP access used by MapAnalyst (map fetch/visualize) and background mission poller.
MISSION_CONTROL_URL=http://195.225.110.91:8050
MISSION_DISPATCH_URL=http://185.55.57.82:8051

# ─── stdio fallback (used when MISSION_*_TRANSPORT=stdio) ──────────────────────
MISSION_CONTROL_COMMAND=python
MISSION_CONTROL_ARGS=-m mission_control_mcp.server
MISSION_DISPATCH_COMMAND=python
MISSION_DISPATCH_ARGS=-m mission_dispatch_mcp.server

# ─── ROS-MSP (rosbridge MCP) ───────────────────────────────────────────────────
ROS_MSP_TRANSPORT=streamable-http
ROS_MSP_MCP_URL=http://ros-msp:8000/mcp

# rosbridge endpoint — IP of the machine running rosbridge_server (Isaac workspace host)
ROSBRIDGE_IP=195.225.110.91
ROSBRIDGE_PORT=9090

# stdio fallback (used when ROS_MSP_TRANSPORT=stdio)
ROS_MSP_COMMAND=uv
ROS_MSP_ARGS=--directory /opt/ros-mcp-server run server.py

# ─── Agents SDK / LLM providers ────────────────────────────────────────────────
# 1 = use real Agents SDK, 0 = simulator (default for local dev and tests)
AGENTS_USE_SDK=0

# Provider switch: openai | vllm | openrouter
AGENTS_PROVIDER=openai

# OpenAI (if AGENTS_PROVIDER=openai)
OPENAI_API_KEY=changeme
OPENAI_BASE_URL=https://api.openai.com/v1

# vLLM (if AGENTS_PROVIDER=vllm)
VLLM_BASE_URL=http://vllm-service:8000/v1
VLLM_API_KEY=EMPTY

# OpenRouter (if AGENTS_PROVIDER=openrouter)
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_SITE_URL=https://your-site.com

# Optional HTTP proxy for LLM API calls
PROXY_HOST=
PROXY_PORT=
PROXY_USER=
PROXY_PASS=

# ─── Model and generation settings ─────────────────────────────────────────────
AGENTS_MODEL=gpt-4o-mini
# Sampling temperature (0.0 = greedy/deterministic, 1.0 = creative)
AGENTS_TEMPERATURE=0.3
# Top-p nucleus sampling — leave empty to use the model's default
AGENTS_TOP_P=
# Max tokens per agent response — leave empty for model default
AGENTS_MAX_OUTPUT_TOKENS=
# Include full handoff history in nested agent context (0 = off, 1 = on)
AGENTS_NEST_HANDOFF_HISTORY=0
# Disable Agents SDK tracing (0 = enabled, 1 = disabled)
AGENTS_TRACING_DISABLED=1
# Max agent turns per plan step before giving up (prevents infinite tool-call loops)
AGENTS_MAX_TURNS=60

# ─── Mission polling (background job) ──────────────────────────────────────────
# How often (seconds) the background poller checks mission status after dispatch
MISSION_POLL_INTERVAL=10
# Default mission timeout passed to Mission Dispatch when creating a mission (seconds)
MISSION_DISPATCH_TIMEOUT=3600

# ─── Planner ───────────────────────────────────────────────────────────────────
# Max replan attempts on plan failure (0 = no replan, 1 = single retry)
PLAN_REPLAN_MAX=1

# ─── Debug ─────────────────────────────────────────────────────────────────────
# Set to 1 to enable debug-only routes (e.g. /debug/crash)
ENABLE_DEBUG_ROUTES=0
