# Node 1 (Worker) environment variables
# Copy this file to .env on Node 1 server
# Usage:
#   cp .env.node1 .env
#   docker-compose up -d

# -------------------------------------------
# Server Network Settings
# -------------------------------------------
VLLM_HOST=0.0.0.0
VLLM_PORT=8000
VLLM_API_KEY=

# -------------------------------------------
# Data Parallel Settings (Worker)
# -------------------------------------------
VLLM_DATA_PARALLEL_SIZE=2
VLLM_DATA_PARALLEL_RANK=1
VLLM_DATA_PARALLEL_ADDRESS=10.0.0.1
VLLM_DATA_PARALLEL_RPC_PORT=13345
VLLM_DATA_PARALLEL_SIZE_LOCAL=1

# -------------------------------------------
# GPU/Engine Settings
# -------------------------------------------
VLLM_CUDA_VISIBLE_DEVICES=1

# -------------------------------------------
# Optional Generalized Settings
# -------------------------------------------
# These settings are taken from config/settings.toml unless overridden here.
# Uncomment and modify the following lines as needed:

# Model settings
# VLLM_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
# VLLM_MODEL_DTYPE=auto
# VLLM_MAX_MODEL_LEN=4096
# VLLM_GPU_MEMORY_UTILIZATION=0.9

# Engine settings
# VLLM_TENSOR_PARALLEL_SIZE=1
# VLLM_MAX_NUM_SEQS=256
# VLLM_MAX_NUM_BATCHED_TOKENS=8192
