# ===========================================
# Node 0 Configuration (Coordinator)
# ===========================================
# Copy this file to .env on Node 0 server
#
# Usage:
#   cp .env.node0 .env
#   docker-compose up -d
#
# IMPORTANT: Change DATA_PARALLEL_ADDRESS to your machine's IP!

# -------------------------------------------
# Model Configuration
# -------------------------------------------
VLLM_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
VLLM_MODEL_DTYPE=auto
VLLM_MAX_MODEL_LEN=4096
VLLM_GPU_MEMORY_UTILIZATION=0.9

# -------------------------------------------
# Server Configuration
# -------------------------------------------
VLLM_PORT=8000
VLLM_API_KEY=
VLLM_HOSTNAME=vllm-node-0
VLLM_CONTAINER_NAME=vllm-node0

# -------------------------------------------
# Network Configuration (required for Data Parallel)
# -------------------------------------------
# Use host network for ZMQ communication
VLLM_NETWORK_MODE=host
VLLM_IPC_MODE=host
# CUDA device for this container
VLLM_CUDA_VISIBLE_DEVICES=0

# -------------------------------------------
# Data Parallel Configuration
# -------------------------------------------
# Total number of nodes in the cluster
VLLM_DATA_PARALLEL_SIZE=2

# This node's rank (0 = coordinator)
VLLM_DATA_PARALLEL_RANK=0

# IP address of the coordinator node (this node)
# CHANGE THIS to your actual IP address (e.g., 192.168.1.100)
# Run: hostname -I | awk '{print $1}' to get your IP
VLLM_DATA_PARALLEL_ADDRESS=localhost

# RPC port for coordination
VLLM_DATA_PARALLEL_RPC_PORT=13345

# Number of GPUs on this node
VLLM_DATA_PARALLEL_SIZE_LOCAL=1

# -------------------------------------------
# Engine Configuration
# -------------------------------------------
VLLM_TENSOR_PARALLEL_SIZE=1
VLLM_MAX_NUM_SEQS=256
VLLM_MAX_NUM_BATCHED_TOKENS=8192

# -------------------------------------------
# Logging
# -------------------------------------------
VLLM_LOG_LEVEL=INFO
